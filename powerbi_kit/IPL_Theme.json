{
  "name": "IPL Dark",
  "dataColors": ["#3B82F6", "#F9CD05", "#A78BFA", "#EF4444", "#10B981", "#F59E0B", "#06B6D4", "#EC4899"],
  "background": "#1E293B",
  "foreground": "#FFFFFF",
  "tableAccent": "#F9CD05",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "maximum": "#3B82F6",
  "center": "#F9CD05",
  "minimum": "#EF4444",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "title":   { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E2E8F0" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#94A3B8" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [{ "fontFamily": "Segoe UI" }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 12 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#1E293B" } }, "transparency": 0 }],
        "border": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0F172A" } }, "transparency": 0 }]
      }
    }
  }
}
